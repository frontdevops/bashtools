#!/usr/bin/env bash

# Wizard that adds a job to crontab.dev.txt / crontab.prod.txt
#
#   ./cronsetup dev
#
# It never touches the system crontab: it only appends the job to the file.
# Installing is a separate step: cronedit dev

set -Eeuo pipefail

# Job files belong to the caller's project, regardless of the script's location.
# An explicit CRONTAB_DIR overrides the working directory; do not fall back to
# the demo files next to the installed tools.
JOB_DIR="${CRONTAB_DIR:-$PWD}"
[[ "$JOB_DIR" == /* ]] || JOB_DIR="$PWD/$JOB_DIR"

find_crontab_file() {
    local file="$JOB_DIR/crontab.$1.txt"
    [[ -f "$file" ]] || return 1
    printf '%s' "$file"
}

searched_dirs() {
    printf '\n    %s/crontab.%s.txt' "$JOB_DIR" "$1"
}

# Prefix put in front of discovered scripts. Defaults to the project directory
# itself, so paths are correct on this machine; set CRON_PATH_PREFIX when the
# project lives elsewhere on the target server, e.g. CRON_PATH_PREFIX=/www.
PATH_PREFIX="${CRON_PATH_PREFIX:-}"

ENVIRONMENT=""

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
CYAN="\033[0;36m"
BOLD="\033[1m"
DIM="\033[2m"
NC="\033[0m"

log() {
    echo -e "${CYAN}➜${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warn() {
    echo -e "${YELLOW}!${NC} $1"
}

error() {
    printf '%b %s\n' "${RED}✗${NC}" "$1" >&2
}

die() {
    error "$1"
    exit 1
}

hr() {
    echo -e "${DIM}──────────────────────────────────────────────${NC}"
}

step() {
    echo
    echo -e "${BOLD}${CYAN}Step $1/6${NC} ${BOLD}$2${NC}"
}

flush_tty() {
    { : < /dev/tty; } 2>/dev/null || return 0
    while read -r -t 0.05 -n 10000 _ < /dev/tty 2>/dev/null; do :; done
    true
}

cancel() {
    warn "Cancelled — the file was not modified"
    exit 0
}

# Pick a single item: $1 is the prompt, $2 the header, the rest are the items.
pick_one() {
    local prompt="$1" header="$2"
    shift 2
    flush_tty
    printf '%s\n' "$@" |
        fzf \
            --height=16 \
            --border \
            --reverse \
            --prompt="$prompt" \
            --header="$header" \
        || true
}

ask() {
    local prompt="$1" default="${2:-}" answer
    flush_tty
    if [[ -n "$default" ]]; then
        read -r -p "$prompt [$default]: " answer
        printf '%s' "${answer:-$default}"
    else
        read -r -p "$prompt: " answer
        printf '%s' "$answer"
    fi
}

usage() {
    cat <<USAGE
Usage: $(basename "$0") [dev|prod]

The wizard asks a few questions and appends a ready job to crontab.<environment>.txt.
Installing it into the system crontab is a separate step: cronedit <environment>
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        dev|prod) ENVIRONMENT="$1"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "Unknown argument: $1" ;;
    esac
done

clear 2>/dev/null || true

echo -e "${BOLD}${CYAN}"
echo "Cron Task Wizard"
echo -e "${NC}"

hr

command -v fzf >/dev/null || die "fzf is not installed — run: sudo apt install -y fzf"

# --- Step 1: environment ---

step 1 "Environment"

if [[ -z "$ENVIRONMENT" ]]; then
    ENV_DEV="dev  — crontab.dev.txt (development server)"
    ENV_PROD="prod — crontab.prod.txt (production server)"

    ENV_CHOICE="$(pick_one "Environment > " "Where to add the job" "$ENV_DEV" "$ENV_PROD")"
    [[ -n "$ENV_CHOICE" ]] || cancel

    case "$ENV_CHOICE" in
        "$ENV_DEV")  ENVIRONMENT="dev" ;;
        "$ENV_PROD") ENVIRONMENT="prod" ;;
    esac
fi

TARGET_FILE="$(find_crontab_file "$ENVIRONMENT" || true)"
[[ -n "$TARGET_FILE" ]] || die "crontab.$ENVIRONMENT.txt not found. Looked in:$(searched_dirs "$ENVIRONMENT")
    Point to the directory explicitly: CRONTAB_DIR=/path/to/project $(basename "$0") $ENVIRONMENT"

success "File: $TARGET_FILE"

# --- Step 2: what to run ---

step 2 "What to run"

# Scan the project the crontab file belongs to, not the directory cronsetup
# itself lives in — the two differ when cronsetup is installed separately.
SCAN_DIR="${CRON_SCAN_DIR:-$(cd "$(dirname "$TARGET_FILE")" && pwd)}"
[[ -n "$PATH_PREFIX" ]] || PATH_PREFIX="$SCAN_DIR"

SCRIPTS=()
while IFS= read -r rel; do
    [[ -n "$rel" ]] && SCRIPTS+=("${PATH_PREFIX%/}/$rel")
done < <(
    cd "$SCAN_DIR" && find . -maxdepth 4 -type f \( -name '*.sh' -o -perm -u+x \) \
        ! -path './.git/*' ! -path '*/node_modules/*' ! -path '*/vendor/*' 2>/dev/null |
        sed 's|^\./||' | sort -u
)

MANUAL_CMD="Enter a command manually"

CMD_OPTS=()
[[ "${#SCRIPTS[@]}" -gt 0 ]] && CMD_OPTS=("${SCRIPTS[@]}")
CMD_OPTS+=("$MANUAL_CMD")

CMD_CHOICE="$(pick_one "Command > " "Scripts found in $SCAN_DIR (shown with the server prefix) or manual entry" "${CMD_OPTS[@]}")"
[[ -n "$CMD_CHOICE" ]] || cancel

if [[ "$CMD_CHOICE" == "$MANUAL_CMD" ]]; then
    COMMAND="$(ask "Full command (for example: /usr/bin/php /www/sites/app/cli.php run)")"
    [[ -n "$COMMAND" ]] || die "Empty command"
else
    COMMAND="$CMD_CHOICE"
    ARGS="$(ask "Arguments (press Enter for none)" "")"
    [[ -n "$ARGS" ]] && COMMAND="$COMMAND $ARGS"
fi

success "Command: $COMMAND"

# --- Step 3: schedule ---

step 3 "Schedule"

S_MIN5="Every 5 minutes"
S_MIN10="Every 10 minutes"
S_MIN30="Every 30 minutes"
S_HOURLY="Every hour on the hour"
S_DAILY="Every day at a given time"
S_WEEKLY="Once a week, on a given day and time"
S_MONTHLY="Once a month, on a given day and time"
S_REBOOT="At server startup (@reboot)"
S_MANUAL="Enter a cron expression manually"

SCHED_CHOICE="$(pick_one "Schedule > " "How often to run it" \
    "$S_DAILY" "$S_HOURLY" "$S_MIN5" "$S_MIN10" "$S_MIN30" \
    "$S_WEEKLY" "$S_MONTHLY" "$S_REBOOT" "$S_MANUAL")"
[[ -n "$SCHED_CHOICE" ]] || cancel

# Time as HH:MM, with range checking.
ask_time() {
    local default="$1" value hh mm
    while true; do
        value="$(ask "Time (HH:MM)" "$default")"
        if [[ "$value" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
            hh="${BASH_REMATCH[1]}"
            mm="${BASH_REMATCH[2]}"
            if [[ "$((10#$hh))" -le 23 && "$((10#$mm))" -le 59 ]]; then
                printf '%s %s' "$((10#$mm))" "$((10#$hh))"
                return 0
            fi
        fi
        error "That does not look like a time: '$value'"
    done
}

case "$SCHED_CHOICE" in
    "$S_MIN5")
        SCHEDULE="*/5 * * * *"
        HUMAN="every 5 minutes" ;;
    "$S_MIN10")
        SCHEDULE="*/10 * * * *"
        HUMAN="every 10 minutes" ;;
    "$S_MIN30")
        SCHEDULE="*/30 * * * *"
        HUMAN="every 30 minutes" ;;
    "$S_HOURLY")
        SCHEDULE="0 * * * *"
        HUMAN="every hour on the hour" ;;
    "$S_DAILY")
        read -r MIN HOUR <<< "$(ask_time "04:00")"
        SCHEDULE="$MIN $HOUR * * *"
        HUMAN="$(printf 'every day at %02d:%02d' "$HOUR" "$MIN")" ;;
    "$S_WEEKLY")
        D_MON="Monday"; D_TUE="Tuesday"; D_WED="Wednesday"; D_THU="Thursday"
        D_FRI="Friday"; D_SAT="Saturday";  D_SUN="Sunday"
        DAY_CHOICE="$(pick_one "Day > " "Day of the week" \
            "$D_MON" "$D_TUE" "$D_WED" "$D_THU" "$D_FRI" "$D_SAT" "$D_SUN")"
        [[ -n "$DAY_CHOICE" ]] || cancel
        case "$DAY_CHOICE" in
            "$D_MON") DOW=1; DAY_HUMAN="every Monday" ;;
            "$D_TUE") DOW=2; DAY_HUMAN="every Tuesday" ;;
            "$D_WED") DOW=3; DAY_HUMAN="every Wednesday" ;;
            "$D_THU") DOW=4; DAY_HUMAN="every Thursday" ;;
            "$D_FRI") DOW=5; DAY_HUMAN="every Friday" ;;
            "$D_SAT") DOW=6; DAY_HUMAN="every Saturday" ;;
            "$D_SUN") DOW=0; DAY_HUMAN="every Sunday" ;;
        esac
        read -r MIN HOUR <<< "$(ask_time "04:00")"
        SCHEDULE="$MIN $HOUR * * $DOW"
        HUMAN="$(printf '%s at %02d:%02d' "$DAY_HUMAN" "$HOUR" "$MIN")" ;;
    "$S_MONTHLY")
        while true; do
            DOM="$(ask "Day of the month (1-31)" "1")"
            [[ "$DOM" =~ ^[0-9]{1,2}$ ]] && [[ "$((10#$DOM))" -ge 1 && "$((10#$DOM))" -le 31 ]] && break
            error "The day must be between 1 and 31"
        done
        read -r MIN HOUR <<< "$(ask_time "04:00")"
        SCHEDULE="$MIN $HOUR $((10#$DOM)) * *"
        HUMAN="$(printf 'on day %s of every month at %02d:%02d' "$((10#$DOM))" "$HOUR" "$MIN")" ;;
    "$S_REBOOT")
        SCHEDULE="@reboot"
        HUMAN="at server startup" ;;
    "$S_MANUAL")
        while true; do
            SCHEDULE="$(ask "Cron expression (5 fields, for example '0 4 * * *')")"
            if [[ "$SCHEDULE" =~ ^[-0-9*/,]+[[:space:]]+[-0-9*/,]+[[:space:]]+[-0-9*/,]+[[:space:]]+[-0-9*/,a-zA-Z]+[[:space:]]+[-0-9*/,a-zA-Z]+$ ]]; then
                break
            fi
            error "Expected 5 fields: minute hour day-of-month month day-of-week"
        done
        HUMAN="on schedule '$SCHEDULE'" ;;
esac

success "Schedule: $SCHEDULE ($HUMAN)"

# --- Step 4: output ---

step 4 "Where output goes"

BASE_NAME="$(basename "${COMMAND%% *}")"
BASE_NAME="${BASE_NAME%.*}"
DEFAULT_LOG="/var/log/${BASE_NAME:-cron}.log"

O_LOG="To a log file ($DEFAULT_LOG)"
O_CUSTOM="To a different log file"
O_NULL="Discard it (>/dev/null 2>&1)"
O_MAIL="Leave it alone — cron will email the output"

OUT_CHOICE="$(pick_one "Output > " "What to do with the job's stdout/stderr" \
    "$O_LOG" "$O_CUSTOM" "$O_NULL" "$O_MAIL")"
[[ -n "$OUT_CHOICE" ]] || cancel

case "$OUT_CHOICE" in
    "$O_LOG")
        REDIRECT=">> $DEFAULT_LOG 2>&1" ;;
    "$O_CUSTOM")
        LOG_PATH="$(ask "Log file path" "$DEFAULT_LOG")"
        [[ -n "$LOG_PATH" ]] || die "Empty path"
        REDIRECT=">> $LOG_PATH 2>&1" ;;
    "$O_NULL")
        REDIRECT=">/dev/null 2>&1" ;;
    "$O_MAIL")
        REDIRECT="" ;;
esac

# --- Step 5: description ---

step 5 "Description"

DESCRIPTION="$(ask "Comment above the job" "$BASE_NAME — $HUMAN")"

# --- Step 6: enable it right away? ---

step 6 "State"

E_ON="Enabled — the job is added as an active line"
E_OFF="Disabled — the job is added commented out"

STATE_CHOICE="$(pick_one "State > " "Enable the job right away" "$E_ON" "$E_OFF")"
[[ -n "$STATE_CHOICE" ]] || cancel

if [[ "$STATE_CHOICE" == "$E_ON" ]]; then
    PREFIX=""
    STATE_HUMAN="enabled"
else
    PREFIX="#"
    STATE_HUMAN="disabled"
fi

# --- Summary ---

if [[ -n "$REDIRECT" ]]; then
    JOB_LINE="$SCHEDULE $COMMAND $REDIRECT"
else
    JOB_LINE="$SCHEDULE $COMMAND"
fi

clear 2>/dev/null || true

echo -e "${GREEN}${BOLD}New job${NC}"
echo -e "${CYAN}File:${NC}        $TARGET_FILE"
echo -e "${CYAN}Runs:${NC}        $HUMAN"
echo -e "${CYAN}State:${NC}       $STATE_HUMAN"
echo -e "${CYAN}Description:${NC} $DESCRIPTION"

hr

echo -e "${BOLD}This will be appended to the file:${NC}"
echo
echo -e "  ${DIM}# $DESCRIPTION${NC}"
echo -e "  ${BOLD}${PREFIX}${JOB_LINE}${NC}"
echo

hr

# The same command already in the file is most likely a duplicate.
if grep -qF -- "$COMMAND" "$TARGET_FILE" 2>/dev/null; then
    warn "The file already has a line with this command:"
    grep -nF -- "$COMMAND" "$TARGET_FILE" | sed 's/^/    /'
    hr
fi

flush_tty
read -r -p "Type YES to write it to the file: " CONFIRM
[[ "$CONFIRM" == "YES" ]] || cancel

BACKUP_FILE="$TARGET_FILE.bak"
cp "$TARGET_FILE" "$BACKUP_FILE"

# Make sure the file ends with a newline before appending.
if [[ -n "$(tail -c 1 "$TARGET_FILE")" ]]; then
    printf '\n' >> "$TARGET_FILE"
fi

{
    printf '\n# %s\n' "$DESCRIPTION"
    printf '%s%s\n' "$PREFIX" "$JOB_LINE"
} >> "$TARGET_FILE"

success "Job added to $TARGET_FILE (backup: $BACKUP_FILE)"

hr
log "Install it into the system crontab with: cronedit $ENVIRONMENT"
hr

#EOF#
